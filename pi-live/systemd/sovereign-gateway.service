[Unit]
Description=Sovereign Edge Gateway FastAPI service
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=dmaster
WorkingDirectory=/home/dmaster/sovereign-gateway
Environment="PATH=/home/dmaster/sovereign-gateway/venv/bin"
ExecStart=/home/dmaster/sovereign-gateway/venv/bin/uvicorn app:app --host 0.0.0.0 --port 8001 --workers 1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
